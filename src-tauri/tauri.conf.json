{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Doctor",
  "version": "0.3.0",
  "identifier": "com.zshadow7x.linuxdoctor",
  "build": {
    "frontendDist": "../src-gui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "🩺 Linux Doctor",
        "width": 920,
        "height": 720,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/doctor.js": "bin/doctor.js",
      "../src/*.js": "src/",
      "../src/checks/*.js": "src/checks/",
      "../src-gui/index.html": "src-gui/index.html",
      "../package.json": "package.json"
    }
  }
}
