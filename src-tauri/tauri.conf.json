{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Doctor",
  "version": "0.5.0",
  "identifier": "com.zshadow7x.linuxdoctor",
  "build": {
    "frontendDist": "../src-gui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "🩺 Linux Doctor",
        "width": 1500,
        "height": 950,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* tauri://localhost https://tauri.localhost ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/doctor.js": "bin/doctor.js",
      "../src/*.js": "src/",
      "../src/checks/*.js": "src/checks/",
      "../src-gui/index.html": "src-gui/index.html",
      "../package.json": "package.json",
      "runtime/node": "runtime/node"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQ0RBQUE0NjAwQjUyQjYKUldTMlVndGdwS3JOWDNJYjZkZGRhaW92azI5TFRXeHREQkVEbmpoYkF4ZUlKWFFaSkxJayt6Z1cK",
      "endpoints": [
        "https://github.com/zShaD0w7x/linux-doctor/releases/latest/download/latest.json"
      ]
    }
  }
}
